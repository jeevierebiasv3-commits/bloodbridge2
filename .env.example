# Copy to .env and fill in. All values are server-only (read by Expo API routes);
# never prefix with EXPO_PUBLIC_.

# Neon Postgres connection string (Console → your project → Connect)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Base URL the auth server runs on (Expo dev server)
BETTER_AUTH_URL=http://localhost:8081
